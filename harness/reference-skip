# Cases the reference compiler cannot compile (PROPOSAL.md §1b, harness/README.md):
# the reference side skips them, and each has only a .iecf.trace, checked by hand.
connections   # program connections: iec2c crashes or writes C that does not compile
sfc
parts         # CONCAT_DATE, CONCAT_TOD, CONCAT_DT, the SPLITs: the reference compiler has none of Table 36's
splitwrap     # the same: SPLIT
splitindex
splitclamp
splitenable
ldates        # LDATE, LTOD, LDT: the reference compiler has none
fbskip        # NOT ENO => : the reference compiler's iec2c fails (internal compiler error)
progio        # program connections, as connections
located       # an LTIME at an address: the reference compiler refuses it, and its TIME is a structure
locdata       # an array at an address: the reference compiler refuses it
refimage      # REF_TO: r^ := ... does not compile in the reference compiler's C; REF_TO a block crashes it
refto         # REFERENCE TO: CODESYS's, an extension (docs/extensions.md); the reference compiler has none
widen         # implicit conversions (Ed.3 6.6.1.6): the reference compiler has none (Ed.2)
fnoutx        # a FUNCTION's outputs: NOT q => crashes the reference compiler, no implicit conversions, an output into an element does not compile
fnorder       # VAR_EXTERNAL in a FUNCTION: the reference compiler (Ed.2) refuses it
chars         # CHAR is Ed.3's: the reference compiler (Ed.2) has none
implicit      # the implicit-externals extension: the reference compiler has none
namespaces    # NAMESPACE (Ed.3): the reference compiler (Ed.2) has none; two files
globalns      # the global-namespace extension, and namespaces
inoutcopy     # an in-out given an array element: the reference compiler's C does not compile (assignment to expression with array type)
fneffen       # EN on a FUNCTION with effects: VAR_EXTERNAL in a FUNCTION, which the reference compiler (Ed.2) refuses
stringchars   # s[i], a STRING's character (Ed.3): the reference compiler (Ed.2) has none
wstrings      # WCHAR and s[i] (Ed.3): the reference compiler (Ed.2) has neither
wlocated      # a WSTRING at an address: WCHAR and s[i] (Ed.3), and the reference compiler refuses an array there
wrefs         # REF_TO a WSTRING, at an address and in C: WCHAR and s[i] are Ed.3's
methods       # CLASS and METHOD (Ed.3): the reference compiler (Ed.2) has neither
inherit       # EXTENDS, OVERRIDE, SUPER (Ed.3): the reference compiler (Ed.2) has none
interfaces    # INTERFACE, IMPLEMENTS, ?= (Ed.3): the reference compiler (Ed.2) has none
instances     # arrays and structures of instances, a CLASS, an INTERFACE, PUBLIC (Ed.3): the reference compiler (Ed.2) has none
fnparams      # a method, an INTERFACE and WSTRING (Ed.3): the reference compiler (Ed.2) has none
itfplaces     # INTERFACE and CLASS (Ed.3): the reference compiler (Ed.2) has neither
itfprog       # INTERFACE and CLASS (Ed.3), and program connections, which the reference compiler cannot compile
flexarrays    # ARRAY[*], LOWER_BOUND, UPPER_BOUND and CLASS (Ed.3): the reference compiler (Ed.2) has none
enums         # named values (Ed.3 6.4.4.3): the reference compiler (Ed.2) has none
flexio        # ARRAY[*], LOWER_BOUND, UPPER_BOUND and CLASS (Ed.3): the reference compiler (Ed.2) has none
instvalues    # the reference compiler refuses it: an instance in a structure, as a FUNCTION's result and as a FUNCTION's variable (tried in CI, 2026-11-11)
callparts     # the reference compiler refuses it: an array or an instance as a FUNCTION's result, and a part of a call, MKP(k).x (tried in CI, 2026-11-11)
holders       # the reference compiler has no instance in a structure (tried in CI on instvalues, 2026-11-11)
flexcopy      # ARRAY[*] (Ed.3): the reference compiler (Ed.2) has none
inoutdata     # ARRAY[*] (Ed.3): the reference compiler (Ed.2) has none
fbargs        # named values (Ed.3 6.4.4.3): the reference compiler (Ed.2) has none
constinit     # constants in initial values and bounds: not tried on the reference compiler here; it refuses flexarrays' constant bounds
litcalls      # a function call in an initial value: the reference compiler refuses it
constfns      # initial values of constants: the reference compiler takes no constant in one (as constinit)
stdinout      # a block instance as an in-out: iec2c crashes
subparams     # a call with no arguments: refused; and a subrange starts at 0 there (Ed.3 6.4.4.4: its lower limit), not clamped into one
extcompare    # no LTIME; -t on a TIME and SHL on a BOOL: its C does not build
selectdata    # SEL, MUX, MOVE of arrays and structures, methods: the reference compiler refuses them
refmore       # methods; a write through a reference: its C does not build
targetidx     # ARRAY OF ARRAY: the reference compiler refuses it
connect2      # program connections: the reference compiler crashes on them (connections)
nesten        # a nested call with ENO or an in-out, an array input: its C does not build
edgeinputs    # R_EDGE and F_EDGE: the reference compiler does not support them
partaccess    # partial access (Ed.3): the reference compiler (Ed.2) has none
locmore       # a located variable without a name, an array at an address: refused
enointo       # partial access, NOT ENO =>: refused (iec2c crashes on the latter)
retainloc     # a warm restart: the reference compiler's host makes it a cold one (retain)
single        # SINGLE-triggered tasks: the reference compiler's host knows none
layout        # relative locations and OVERLAP (Ed.3): the reference compiler (Ed.2) has none
layout2       # relative locations and OVERLAP (Ed.3): the reference compiler (Ed.2) has none
locinit       # enumerated values, arrays and structures at an address: refused
varconfig     # VAR_CONFIG and %I* addresses: the reference compiler generates nothing for VAR_CONFIG
resglobals    # a resource's globals: its C does not link
progglobals   # VAR_GLOBAL in a PROGRAM: the reference compiler refuses it
resaccess     # program connections, as connections
progretain    # AT %Q* in a PROGRAM; VAR_CONFIG generates nothing; no warm restart
shadow        # a global named as an outer one: the reference compiler refuses it
keptref       # RETAIN on a program instance, as progretain
retainref     # REF_TO in a structure (its -R); no warm restart
caseany       # CASE on anything but an integer or an enumeration: refused
fbinorder     # methods, EXTENDS: refused
mutual        # two blocks naming each other, with a method and REF_TO a block: as refimage
toplist       # VAR_GLOBAL outside a CONFIGURATION: the reference compiler's grammar has none
constinit2    # functions of constants in initial values: the reference compiler takes a literal there
constinit3    # functions of constants in initial values: the reference compiler takes a literal there
debugsteps    # a debug build: iecf's own
refparams     # REF_TO parameters and methods: as refmore
directwrite   # a direct address on the left of := : refused
fbparts       # partial access, as partaccess
hieraddr      # hierarchical addresses: the reference compiler takes one level
inouteffects  # VAR_IN_OUT of a FUNCTION, as fnorder
inoutstop     # VAR_IN_OUT of a FUNCTION, as fnorder
leftout       # a standard function called by name with inputs left out: the reference compiler's C for MUL(IN2 := v) does not compile, and it has no LEN()
fbencall      # METHOD and INTERFACE (Ed.3): the reference compiler (Ed.2) has neither
outelems      # an output into an element (as fnoutx) and REF_TO STRING[8]: the reference compiler refuses both
